type ModeKey = 'return' | 'enquiries' | 'dormant';
type RouteKey = 'home' | 'how' | 'services' | 'proof' | 'about' | 'resources' | 'fit';
type OfferKey = 'fit' | 'growth' | 'sprint';

type Mode = {
  key: ModeKey;
  label: string;
  short: string;
  eyebrow: string;
  signal: string;
  age: string;
  priority: 'High' | 'Medium';
  headline: string;
  body: string;
  next: string;
  path: string[];
  gates: {label:string; value:string; tone:'good'|'warn'|'alert'|'neutral'}[];
  curve: {label:string; value:number}[];
  recommendation: OfferKey;
};

