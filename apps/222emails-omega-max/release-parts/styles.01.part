:root{
  --navy:#06173D;--navy-2:#0B2556;--navy-3:#102E69;--orange:#FF6600;--orange-dark:#C84D00;--cream:#F7F3EC;--soft:#F6F8FB;--white:#fff;--ink:#111827;--muted:#606A7B;--line:#E4E7EC;--green:#197A4B;--green-soft:#E7F7EE;--amber:#9B5B00;--amber-soft:#FFF4D9;--red:#A12B1F;--red-soft:#FFF0EC;--shadow:0 20px 60px rgba(6,23,61,.10);--font:"Helvetica Neue",Helvetica,Arial,sans-serif;
}
*{box-sizing:border-box}html{scroll-behavior:smooth;background:white}body{margin:0;font-family:var(--font);font-weight:500;color:var(--ink);background:white;line-height:1.5;letter-spacing:-.006em}button,input,textarea{font:inherit}button,a{touch-action:manipulation}a{color:inherit;text-decoration:none}img{max-width:100%;display:block}h1,h2,h3,p{margin-top:0}h1,h2,h3{color:var(--navy);font-weight:800;letter-spacing:-.045em;line-height:1.02}.shell{width:min(1180px,calc(100% - 48px));margin:auto}.skip-link{position:absolute;left:-999px;top:10px;background:#fff;color:var(--navy);padding:10px 14px;border-radius:8px;z-index:200}.skip-link:focus{left:10px}.site-header{height:78px;background:rgba(255,255,255,.97);border-bottom:1px solid rgba(6,23,61,.08);position:sticky;top:0;z-index:100;backdrop-filter:blur(14px)}.nav-shell{width:min(1180px,calc(100% - 48px));height:100%;margin:auto;display:grid;grid-template-columns:120px 1fr 160px;align-items:center}.brand-mark{display:inline-flex;width:42px;height:42px}.brand-mark img{width:42px;height:42px;object-fit:contain}.desktop-nav{display:flex;gap:34px;justify-content:center;align-items:center;font-size:14px;font-weight:700}.desktop-nav a{position:relative;padding:28px 0}.desktop-nav a:after{content:"";position:absolute;left:0;right:100%;bottom:18px;height:2px;background:var(--orange);transition:right .2s ease}.desktop-nav a:hover:after,.desktop-nav a.active:after{right:0}.nav-cta{justify-self:end;background:var(--navy);color:#fff;border-radius:7px;padding:12px 17px;font-weight:700;font-size:13px}.menu-button,.mobile-nav{display:none}.eyebrow{font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.09em;color:#7A8494;margin-bottom:16px}.orange-text{color:var(--orange-dark)}.center{text-align:center}.button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 20px;border-radius:7px;font-weight:700;font-size:14px;border:1px solid transparent;transition:transform .18s ease,box-shadow .18s ease,background .18s ease}.button:hover{transform:translateY(-2px)}.button.orange{background:var(--orange);color:var(--navy);box-shadow:0 10px 25px rgba(255,102,0,.18)}.button.navy{background:var(--navy);color:white}.button.ghost{border-color:#C9CFD8;background:white;color:var(--navy)}.button.dark-outline{border-color:rgba(255,255,255,.5);color:white;background:transparent}.button.full{width:100%}.text-cta{display:inline-flex;align-items:center;gap:8px;font-weight:700;color:var(--navy);font-size:14px}.text-cta svg{width:17px}.home-hero{padding:92px 0 72px;background:white}.hero-grid{display:grid;grid-template-columns:.92fr 1.08fr;gap:68px;align-items:center}.hero-copy h1{font-size:clamp(54px,5.4vw,78px);letter-spacing:-.058em;max-width:650px;margin-bottom:24px}.hero-lead{font-size:19px;line-height:1.55;color:#384151;max-width:620px}.hero-actions{display:flex;gap:12px;margin:30px 0}.hero-trust{display:flex;gap:26px;flex-wrap:wrap;margin-top:30px;color:#485263;font-size:12px;font-weight:700}.hero-trust span{display:flex;align-items:center;gap:7px}.hero-trust svg{color:var(--navy);width:18px}.recovery-app{display:grid;grid-template-columns:112px 1fr;background:white;border:1px solid #D9DEE7;border-radius:14px;box-shadow:var(--shadow);overflow:hidden;min-height:480px}.app-sidebar{background:#FAFBFD;border-right:1px solid #E4E7EC;padding:16px 12px;display:flex;flex-direction:column;gap:5px}.app-sidebar img{width:34px;height:34px;object-fit:contain;margin:0 0 12px 7px}.side-item{display:flex;gap:8px;align-items:center;font-size:10px;font-weight:700;color:#667085;padding:9px 9px;border-radius:6px}.side-item.active{background:var(--navy);color:white}.side-item i{font-style:normal;width:14px;text-align:center}.app-main{padding:18px}.app-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}.app-top small{display:block;color:#8A93A2;font-size:9px}.app-top strong{display:block;color:var(--navy);font-size:15px;margin-top:2px}.example-badge{font-size:9px;font-weight:700;border:1px solid #E1E5EB;color:#7D8696;padding:6px 8px;border-radius:999px}.opportunity-list{border:1px solid #E3E6EB;border-radius:9px;overflow:hidden}.opportunity-list button{width:100%;border:0;border-bottom:1px solid #E9EBEF;background:white;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:9px;text-align:left;padding:12px 13px;cursor:pointer;color:var(--ink)}.opportunity-list button:last-child{border-bottom:0}.opportunity-list button:hover,.opportunity-list button.selected{background:#F8FAFD}.opportunity-list span b{font-size:11px;color:var(--navy);display:block}.opportunity-list span small{font-size:9px;color:#8A92A0}.opportunity-list em{font-style:normal;font-size:9px;background:#FFF1E8;color:#B74600;padding:4px 6px;border-radius:5px;font-weight:700}.status-dot{width:8px;height:8px;border-radius:50%;background:#FF8A00}.status-dot.dormant{background:#35A866}.status-dot.enquiries{background:#F2B600}.app-bottom-grid{display:grid;grid-template-columns:1fr 1fr;gap:11px;margin-top:11px}.mini-panel{border:1px solid #E4E7EC;border-radius:9px;padding:12px;min-width:0}.mini-title{font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.04em;color:#647084}.mini-title small{font-size:8px;font-weight:500;color:#A0A6B0;text-transform:none}.line-chart{height:122px;padding-top:14px}.line-chart svg{width:100%;height:72px;overflow:visible}.chart-labels{display:flex;justify-content:space-between;color:#9299A6;font-size:8px}.gate-list{display:grid;gap:8px;margin-top:13px}.gate-list div{display:flex;justify-content:space-between;gap:8px;align-items:center;font-size:9px;color:#667085}.gate-list b{font-size:8px;padding:4px 5px;border-radius:4px;background:#F1F3F5;color:#596273}.gate-list .good{background:var(--green-soft);color:var(--green)}.gate-list .warn{background:var(--amber-soft);color:var(--amber)}.gate-list .alert{background:var(--red-soft);color:var(--red)}.evidence-strip{background:#FBFCFD;border-top:1px solid #ECEFF3;border-bottom:1px solid #ECEFF3;padding:26px 0 18px}.evidence-grid{display:grid;grid-template-columns:repeat(4,1fr)}.evidence-grid>div{text-align:center;padding:3px 24px;border-right:1px solid #E2E6EC}.evidence-grid>div:last-child{border-right:0}.evidence-grid strong{display:block;color:var(--navy);font-size:25px;font-weight:800}.evidence-grid span{display:block;font-size:10px;color:#687284;margin-top:5px}.evidence-boundary{text-align:center;margin:15px 20px 0;font-size:9px;color:#9198A4}.dark-process{background:var(--navy);padding:88px 0;color:white;text-align:center}.dark-process h2{color:white;font-size:48px;max-width:780px;margin:0 auto 50px}.process-three{display:grid;grid-template-columns:repeat(3,1fr);gap:54px;text-align:left;margin-bottom:42px}.process-three>div{display:grid;grid-template-columns:60px 1fr;column-gap:18px}.icon-disc{grid-row:1/4;width:60px;height:60px;border-radius:50%;background:white;color:var(--navy);display:grid;place-items:center}.icon-disc svg{width:25px;height:25px}.process-three h3{color:white;font-size:22px;margin:4px 0 8px}.process-three p{color:#C6D0DF;font-size:14px;line-height:1.6}.home-focus{padding:108px 0;background:white}.section-heading{max-width:680px}.section-heading.center{text-align:center;margin:auto}.section-heading h2{font-size:50px;margin-bottom:16px}.section-heading>p:last-child{font-size:17px;color:var(--muted)}.mode-pills{display:flex;gap:6px;background:#F2F4F7;border-radius:9px;padding:5px;width:max-content;max-width:100%;margin:35px 0 20px;overflow:auto}.mode-pills button{border:0;background:transparent;border-radius:6px;padding:10px 16px;font-weight:700;font-size:12px;color:#6A7383;cursor:pointer;white-space:nowrap}.mode-pills button.active{background:var(--orange);color:var(--navy);box-shadow:0 3px 10px rgba(255,102,0,.18)}.focus-card{border:1px solid #E0E4EA;border-radius:14px;display:grid;grid-template-columns:1.2fr .8fr;gap:52px;padding:34px;background:#FCFCFD}.focus-card>div+div{border-left:1px solid #E3E6EB;padding-left:42px}.focus-kicker{font-size:10px;color:var(--orange-dark);font-weight:800;text-transform:uppercase;letter-spacing:.06em}.focus-card h3{font-size:30px;margin:8px 0 12px}.focus-card p{color:#646E7E;font-size:14px}.focus-card b{display:block;color:var(--navy);font-size:12px;margin-bottom:6px}.truth-section{padding:95px 0;background:var(--soft)}.truth-inner{display:grid;grid-template-columns:1fr 1fr;gap:100px;align-items:center}.truth-inner h2{font-size:44px}.truth-inner>div:last-child p{color:#5B6576;font-size:17px;line-height:1.65;margin-bottom:25px}.home-fit{padding:70px 0 95px}.home-fit-card{background:#FFF8F3;border:1px solid #FFE2CF;border-radius:16px;padding:34px 38px;display:flex;justify-content:space-between;align-items:center;gap:30px}.home-fit-card h2{font-size:34px;margin:0 0 7px}.home-fit-card p{margin:0;color:#657080}.page-hero{padding:94px 0 70px}.page-hero.light{background:white}.narrow-center{max-width:850px;text-align:center}.page-hero h1{font-size:clamp(50px,5.2vw,72px);margin-bottom:20px}.page-hero p:last-child{font-size:18px;color:#5C6677;max-width:720px;margin:0 auto}.how-core{padding:35px 0 100px}.how-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:90px;align-items:start}.how-steps{display:grid;gap:18px;padding-top:44px}.how-step{display:grid;grid-template-columns:50px 1fr;gap:16px;padding:20px 0;border-bottom:1px solid #ECEEF2}.how-step>span{width:46px;height:46px;border-radius:50%;background:#F7F8FA;display:grid;place-items:center;color:var(--navy)}.how-step small{font-size:10px;color:#A1A7B1;font-weight:700}.how-step h3{font-size:21px;margin:3px 0 6px}.how-step p{font-size:13px;color:#667081;margin:0}.journey-card{border:1px solid #DBE0E7;border-radius:14px;box-shadow:var(--shadow);padding:26px;background:white}.journey-head{display:flex;justify-content:space-between;gap:20px;align-items:start;padding-bottom:17px;border-bottom:1px solid #E6E9EE}.journey-head small{font-size:10px;color:#8C95A3}.journey-head h3{font-size:28px;margin:4px 0 0}.journey-head>span{font-size:10px;color:#9B4D00;background:#FFF0E4;padding:6px 8px;border-radius:999px;font-weight:700}.journey-flow-vertical{padding:22px 0 15px;display:grid;gap:0}.journey-flow-vertical>div{display:grid;grid-template-columns:38px 1fr;align-items:center;min-height:58px;position:relative}.journey-flow-vertical>div:not(:last-child):before{content:"";position:absolute;left:15px;top:38px;height:35px;width:1px;background:#CBD1D9}.journey-flow-vertical i{width:30px;height:30px;border-radius:50%;border:1px solid #C9D0DA;background:white;display:grid;place-items:center;font-size:10px;font-style:normal;color:var(--navy);font-weight:700}.journey-flow-vertical span{font-size:13px;color:#495365;font-weight:700}.journey-foot{background:#F7F8FA;border-radius:9px;padding:14px}.journey-foot small{display:block;font-size:9px;color:#89919F}.journey-foot strong{display:block;color:var(--navy);font-size:13px;margin-top:4px}.how-workspace{padding:100px 0;background:#F7F8FB}.how-workspace .recovery-app{margin-top:48px}.qa-band{padding:80px 0}.qa-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:46px}.qa-grid svg{color:var(--orange-dark);width:26px;height:26px}.qa-grid h3{font-size:21px;margin:15px 0 9px}.qa-grid p{font-size:14px;color:#677183}.page-cta{padding:36px 0 80px}.page-cta-inner{background:var(--navy);color:white;border-radius:15px;padding:36px 42px;display:flex;justify-content:space-between;align-items:center;gap:40px}.page-cta h2{color:white;font-size:32px;margin-bottom:8px}.page-cta p{color:#C6D0DF;margin:0;max-width:680px}.services-main{padd