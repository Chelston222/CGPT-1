  "accounts": {
    "personal": {
      "displayRole": "Chelston personal LinkedIn",
      "primaryJob": "founder trust, authority, conversation and acquisition",
      "baselinePerDay": 1,
      "maximumPerDay": 2,
      "maximumPerWeek": 14,
