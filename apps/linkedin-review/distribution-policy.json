      "allowedContentRoles": [
        "authority",
        "diagnosis",
        "proof",
        "founder_story",
        "teaching",
        "offer",
        "milestone"
      ],
      "preferredSourceTypes": [
        "founder_capture",
        "client_evidence",
        "research",
        "existing_inventory",
        "repurpose"
      ]
    },
    "main": {
      "displayRole": "222Emails company LinkedIn",
      "primaryJob": "company proof, Revenue Recovery category education, systems, resources and route clarity",
      "targetPerWeek": {
        "minimum": 3,
        "maximum": 5
      },
      "maximumPerDay": 1,
      "maximumPerWeek": 5,
      "allowedContentRoles": [
        "authority",
        "diagnosis",
        "proof",
        "teaching",
        "offer",
        "resource",
        "milestone"
      ],
      "rules": [
        "Do not mirror personal-profile copy verbatim by default.",
        "Prefer company evidence, category education, annotated systems, resources and offer clarity.",
        "A post must have a distinct company-page reason to exist."
      ]
    },
    "secondary": {
      "displayRole": "Retention School",
      "legacyDisplayRole": "Retention Lab",
      "primaryJob": "free retention education, curriculum, resources and audience compounding",
      "maximumPerDay": 1,
      "maximumPerWeek": 5,
      "allowedContentRoles": [
        "teaching",
        "resource",
        "diagnosis"
      ],
      "requiredTaxonomy": [
        "category",
        "season",
        "lesson_or_resource"
      ],
      "rules": [
        "Do not use Retention School as a dump for unused personal or 222Emails posts.",
        "Every post must teach, diagnose or provide a reusable resource.",
        "Paid content, direct access and 1:1 offers may be layered later, but public publishing must not invent unverified prices, promises or access rights.",
        "The Buffer channel may keep the legacy technical target name secondary until the live account identity is safely renamed and verified."
      ]
    }
  },
  "contentRoles": [
    "authority",
    "diagnosis",
    "proof",
    "founder_story",
    "teaching",
    "offer",
    "resource",
    "milestone"
