{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["node", "@netlify/functions"]
  },
  "include": ["netlify/functions/**/*.ts", "netlify/functions/_shared/**/*.mjs"]
}
