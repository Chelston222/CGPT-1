# Required runtime secrets. Store in GitHub Actions secrets, never commit real values.
TTE_BRIDGE_TOKEN=replace-with-strong-random-secret
TTE_TOKEN_ENCRYPTION_KEY=replace-with-another-strong-random-secret
TTE_TOKEN_ENCRYPTION_KEY_PREVIOUS=
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-web-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-web-client-secret

# Optional legacy hello@ SMTP sender. Existing bridge compatibility only.
TTE_SMTP_USER=hello@222emails.com
TTE_SMTP_PASS=
TTE_SMTP_HOST=mail.privateemail.com
TTE_SMTP_PORT=465
TTE_SMTP_FROM_NAME=Chelston Phillip

# Non-secret safety configuration. Defaults are conservative if omitted.
TTE_GLOBAL_DAILY_CAP=100
TTE_DOMAIN_DAILY_CAP=4
TTE_DISPATCH_BATCH_SIZE=1
TTE_SCHEDULED_DISPATCH=true
TTE_QUEUE_MAX_SIZE=500
TTE_ALLOW_MANUAL_DISPATCH=false
TTE_QUEUE_TERMINAL_RETENTION_DAYS=90
TTE_SENT_COUNTER_RETENTION_DAYS=35
TTE_AUDIT_RETENTION_DAYS=90
TTE_STALE_IN_FLIGHT_MINUTES=20
TTE_SEND_WINDOW_ENABLED=true
TTE_SEND_START_HOUR=8
TTE_SEND_END_HOUR=18
